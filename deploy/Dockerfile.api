# syntax=docker/dockerfile:1
# One image for four commands: api, worker, bot, migrate. Build context: the repository root.
# Each image has its tag and its digest: the digest fixes the content, also when the owner of the
# image pushes the tag again. Dependabot updates both (.github/dependabot.yml).

# Same uv version as CI, so the lock file is read by the tool that wrote it. A stage of its own:
# Dependabot reads the image of a FROM line, not of COPY --from.
FROM ghcr.io/astral-sh/uv:0.9.3@sha256:ecfea7316b266ba82a5e9efb052339ca410dd774dc01e134a30890e6b85c7cd1 AS uv

FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY --from=uv /uv /bin/uv

# The base image has no bytecode of the standard library, and PYTHONDONTWRITEBYTECODE keeps
# Python from writing it at run time. So each start of Python compiled each module again: the
# healthcheck of the worker and the bot (unshelve.alive) took about 300 ms, not about 60 ms.
RUN python -m compileall -q -j 0 "$(python -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')"

# git and ssh for the git target of the public feed (docs/learn/43).
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first: this layer is rebuilt only when the lock file changes.
COPY apps/api/pyproject.toml apps/api/uv.lock apps/api/.python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY apps/api/ ./
# UV_COMPILE_BYTECODE compiles the packages, but not the code of the app: uv installs the app
# as editable, so its modules stay in /app/src.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev \
    && python -m compileall -q /app/src

# A new volume takes the owner of its folder in the image, so the app can write there:
# /app/var/blobs for the files, /app/var/alive for the liveness files (unshelve.alive).
RUN useradd --system --uid 10001 --create-home app \
    && mkdir -p /app/var/blobs /app/var/alive \
    && chown -R app /app/var
USER app

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
CMD ["unshelve", "api", "--host", "0.0.0.0", "--port", "8000"]
