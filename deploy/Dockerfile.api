# syntax=docker/dockerfile:1
# One image for four commands: api, worker, bot, migrate. Build context: the repository root.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Same uv version as CI, so the lock file is read by the tool that wrote it.
COPY --from=ghcr.io/astral-sh/uv:0.9.3 /uv /bin/uv

# git and ssh for the git target of the public feed (docs/learn/43).
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first: this layer is rebuilt only when the lock file changes.
COPY apps/api/pyproject.toml apps/api/uv.lock apps/api/.python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY apps/api/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# A new volume at /app/var/blobs takes the owner of this folder, so the app can write there.
RUN useradd --system --uid 10001 --create-home app \
    && mkdir -p /app/var/blobs \
    && chown -R app /app/var
USER app

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
CMD ["unshelve", "api", "--host", "0.0.0.0", "--port", "8000"]
