geometry"></mxGeometry></mxCell><mxCell id="n31" value="Publish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="150" height="46" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Who&lt;/b&gt;&lt;br&gt;worker as publisher role" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="150" height="50" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Jobs&lt;/b&gt;&lt;br&gt;publish_feed" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="150" height="70" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Tables&lt;/b&gt;&lt;br&gt;reads pub.items only&lt;br&gt;writes feed.json" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="270" width="150" height="80" as="geometry"/></mxCell><mxCell id="e35" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="n26" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="&lt;b&gt;Rules for every step&lt;/b&gt;&lt;br&gt;1. A job payload holds ids only. The handler reads current state.&lt;br&gt;2. Delivery is at-least-once, so every handler is idempotent.&lt;br&gt;3. No database transaction is held across a network call.&lt;br&gt;4. A step writes its result and enqueues the next step in one transaction.&lt;br&gt;5. A failed fetch marks the item &lt;i&gt;partial&lt;/i&gt;; the pipeline continues with the saved text." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="620" height="110" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Two state columns&lt;/b&gt;&lt;br&gt;&lt;i&gt;status&lt;/i&gt; (inbox, queued, reading, done, archived) is changed only by you.&lt;br&gt;&lt;i&gt;enrich_state&lt;/i&gt; (pending, fetched, enriched, ready, failed) is changed only by workers." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="380" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="3 Job lifecycle"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Job lifecycle: leases and fencing" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="n2" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="208" width="24" height="24" as="geometry"/></mxCell><mxCell id="n3" value="pending" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="190" width="150" height="60" as="geometry"/></mxCell><mxCell id="n4" value="running&lt;br&gt;&lt;span style='font-weight:normal'&gt;locked_by, locked_until&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="190" height="60" as="geometry"/></mxCell><mxCell id="n5" value="done" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="130" height="56" as="geometry"/></mxCell><mxCell id="n6" value="dead" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="280" width="130" height="56" as="geometry"/></mxCell><mxCell id="e7" value="enqueue&lt;br&gt;(dedupe on pending)" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="claim: FOR UPDATE SKIP LOCKED&lt;br&gt;attempts + 1, lease starts" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="fail(retry_after)  ·  reap_expired (lease ran out)" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.0;exitY=0.75;exitDx=0;exitDy=0;entryX=1.0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="heartbeat: extend the lease" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.3158;exitY=0.0;exitDx=0;exitDy=0;entryX=0.6842;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="130"/><mxPoint x="610" y="130"/></Array></mxGeometry></mxCell><mxCell id="e11" value="complete&lt;br&gt;(only while the claim is ours)" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="fail: permanent,&lt;br&gt;or attempts used up" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Why a lease&lt;/b&gt;&lt;br&gt;A worker can die while it holds a job. Nobody extends the lease, it runs out, and the reaper returns the job to &lt;i&gt;pending&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="300" height="110" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Fencing token = attempts&lt;/b&gt;&lt;br&gt;Each claim raises &lt;i&gt;attempts&lt;/i&gt;. complete, fail and heartbeat check (id, running, locked_by, attempts). A slow worker that was replaced cannot overwrite the result of the new one. The clock is not part of the check." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="330" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Invariant in the database&lt;/b&gt;&lt;br&gt;CHECK: state = 'running' exactly when locked_by and locked_until are set. A bug that forgets to release a lease fails at once." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="260" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="4 Item states"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Item states: reading (you) and processing (workers)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;status&lt;/b&gt;: changed only by you. Every change writes an event." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="600" height="24" as="geometry"/></mxCell><mxCell id="n3" value="inbox" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="130" height="50" as="geometry"/></mxCell><mxCell id="n4" value="queued" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="130" height="50" as="geometry"/></mxCell><mxCell id="n5" value="reading" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="130" height="50" as="geometry"/></mxCell><mxCell id="n6" value="done&lt;br&gt;&lt;span style='font-weight:normal'&gt;read_at set&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="150" width="130" height="50" as="geometry"/></mxCell><mxCell id="n7" value="archived" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="130" height="50" as="geometry"/></mxCell><mxCell id="e8" value="queue it" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="start" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="put back" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.0;exitY=0.7;exitDx=0;exitDy=0;entryX=1.0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="finish" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="read it straight away" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1.0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="read again" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="60"/><mxPoint x="365" y="60"/></Array></mxGeometry></mxCell><mxCell id="e14" value="archive" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="265"/></Array></mxGeometry></mxCell><mxCell id="e15" value="restore" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;exitX=0.0;exitY=0.2;exitDx=0;exitDy=0;entryX=1.0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="250"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="255"/></Array></mxGeometry></mxCell><mxCell id="e17" value="" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint