# Copy to .env and fill in. Never commit .env.
# Everything works without this file: the defaults use fake providers and fixture fetching.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
UNSHELVE_TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. The bot answers nobody else, and `unshelve auth link`
# makes a sign-in link for this user. For a local trial without Telegram, any number works.
UNSHELVE_OWNER_TELEGRAM_ID=
# Chats to capture from, as a JSON list. Channel ids start with -100. To find the id of your
# channel: make the bot an administrator, post one message, and read `docker compose logs bot`.
UNSHELVE_CAPTURE_CHAT_IDS=[]

# --- Providers --------------------------------------------------------------
# fake: deterministic local stand-ins. live: real model and embedding calls.
UNSHELVE_PROVIDERS=fake
# fixtures: recorded pages only. live: fetch from the internet.
UNSHELVE_FETCHER=fixtures
UNSHELVE_LLM_MODEL=claude-opus-5-5
# Read by the Anthropic SDK when UNSHELVE_PROVIDERS=live.
ANTHROPIC_API_KEY=

# --- Local stack ------------------------------------------------------------
UNSHELVE_WEB_BASE_URL=http://localhost:3000
UNSHELVE_DB_PASSWORD=unshelve
UNSHELVE_DB_PORT=54329
UNSHELVE_API_PORT=8000
UNSHELVE_WEB_PORT=3000
