# Copy to .env and fill in. Never commit .env.
# Everything works without this file: the defaults use fake providers and fixture fetching.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
UNSHELVE_TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. The bot answers nobody else, and `unshelve auth link`
# makes a sign-in link for this user. For a local trial without Telegram, any number works.
UNSHELVE_OWNER_TELEGRAM_ID=
# Chats to capture from, as a JSON list. Channel ids start with -100. To find the id of your
# channel: make the bot an administrator, post one message, and read `docker compose logs bot`.
UNSHELVE_CAPTURE_CHAT_IDS=[]
# The weekly digest: the bot sends it on this day and hour, in this time zone (a name such
# as Europe/Helsinki). A digest that is late by more than 48 hours is skipped.
UNSHELVE_TIMEZONE=UTC
UNSHELVE_DIGEST_DAY=sunday
UNSHELVE_DIGEST_HOUR=9
# The reading time of a digest, in minutes (5 to 600): its items fit into it (note 34).
UNSHELVE_DIGEST_MINUTES=60

# --- Providers --------------------------------------------------------------
# fake: deterministic local stand-ins, no cost. live: Claude writes the cards (ADR 0011).
UNSHELVE_PROVIDERS=fake
# fixtures: no web; each saved link keeps its saved text. live: the worker reads the page
# of each saved link from the internet, through the guard (ADR 0010).
UNSHELVE_FETCHER=fixtures
# One fetch, with its redirects, may take this many seconds.
UNSHELVE_FETCH_TIMEOUT=30
# Seconds between two requests to the same host.
UNSHELVE_FETCH_HOST_INTERVAL=1
# UNSHELVE_FETCH_USER_AGENT=Mozilla/5.0 (compatible; Unshelve/0.1)
# claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5. Note 17 compares their prices.
UNSHELVE_LLM_MODEL=claude-opus-5-5
# How much the model thinks before it writes a card: low, medium, high, xhigh or max.
UNSHELVE_LLM_EFFORT=low
# No new call on a day when the calls have cost this many dollars. Stored answers are free,
# and so is a batch that you accepted by hand.
UNSHELVE_LLM_DAILY_BUDGET_USD=1.00
# live: each card is asked at once. batch: the cards wait, and `unshelve llm batch send` asks
# for all of them in one batch at half the price (note 29). For the import of a large export.
UNSHELVE_CARDS=live
# The prefilter of the scores against your goals (ADR 0014, note 32): an item whose card is
# less similar than this to each goal gets 0 without a question to the model. -1: no prefilter.
UNSHELVE_SCORE_PREFILTER=0.3
# Read by the Anthropic SDK when UNSHELVE_PROVIDERS=live.
ANTHROPIC_API_KEY=
# The vectors for search (ADR 0012). fake: local, no cost. voyage: Voyage AI makes them; the
# first 200 million tokens of an account are free. A new model gets its own embedding set:
# see `unshelve embeddings status`, `backfill` and `activate` (note 18).
UNSHELVE_EMBEDDER=fake
# voyage-4-large, voyage-4 or voyage-4-lite; vectors of 256, 512, 1024 or 2048 numbers.
UNSHELVE_EMBED_MODEL=voyage-4-large
UNSHELVE_EMBED_DIM=1024
# Read when UNSHELVE_EMBEDDER=voyage. A key of the Voyage platform (pa-...) or a model key of
# MongoDB Atlas (al-...); the address follows the key. Voyage can keep the texts that it gets
# and use them for training: opt out in its dashboard before you embed private texts.
VOYAGE_API_KEY=

# --- Public feed ------------------------------------------------------------
# The items that you make public, as one feed.json for your site (docs/adr/0004). "none"
# publishes nothing. "file" writes the feed to UNSHELVE_PUBLISH_FILE. In the stack, this path
# is inside the container of the worker: mount a folder there to see the file on this computer.
UNSHELVE_PUBLISH_TARGET=none
UNSHELVE_PUBLISH_FILE=var/public/feed.json
# "git" commits the feed to a repository, such as the one of your site, and pushes it
# (docs/learn/43). Use an SSH deploy key with write access to that one repository, not a
# token in the address. Without known hosts, ssh trusts the key of the server at the first
# connection; with them (for example the published keys of GitHub), it trusts only those.
# In the stack, the worker reads the folder keys/ of the clone as /keys (keys/README.md), so
# the key is /keys/deploy_key and the host keys are /keys/known_hosts. UNSHELVE_KEYS_DIR (an
# absolute path) puts that folder outside the clone.
UNSHELVE_PUBLISH_GIT_URL=
UNSHELVE_PUBLISH_GIT_BRANCH=main
UNSHELVE_PUBLISH_GIT_PATH=public/feed.json
UNSHELVE_PUBLISH_GIT_SSH_KEY=
UNSHELVE_PUBLISH_GIT_KNOWN_HOSTS=
# The author of each commit of the feed. A host that builds the site can refuse a commit whose
# author it does not know. Vercel builds a commit of a private repository on the Hobby plan only
# when the commit comes from the owner of the account: there, set the email of the GitHub
# account of the owner, for example its noreply address <id>+<login>@users.noreply.github.com.
UNSHELVE_PUBLISH_GIT_AUTHOR_NAME=Unshelve
UNSHELVE_PUBLISH_GIT_AUTHOR_EMAIL=unshelve@localhost
# "s3" puts the feed as one object into a bucket of an object storage with the S3 API, such as
# Cloudflare R2 or Amazon S3 (docs/learn/44). The endpoint is https and a host, with nothing
# after it: https://<account>.r2.cloudflarestorage.com for R2, https://s3.<region>.amazonaws.com
# for S3. The region signs each request: "auto" for R2, the region of the bucket for S3. Use a
# key pair that may read and write this one bucket, and nothing else.
UNSHELVE_PUBLISH_S3_ENDPOINT=
UNSHELVE_PUBLISH_S3_REGION=
UNSHELVE_PUBLISH_S3_BUCKET=
UNSHELVE_PUBLISH_S3_OBJECT=feed.json
UNSHELVE_PUBLISH_S3_ACCESS_KEY_ID=
UNSHELVE_PUBLISH_S3_SECRET_ACCESS_KEY=

# --- Local stack ------------------------------------------------------------
UNSHELVE_WEB_BASE_URL=http://localhost:3000
UNSHELVE_DB_PASSWORD=unshelve
UNSHELVE_DB_PORT=54329
UNSHELVE_API_PORT=8000
UNSHELVE_WEB_PORT=3000

# --- Backups ----------------------------------------------------------------
# The service backup copies the database and the files that you sent (docs/learn/50). It makes a
# backup when the newest one is older than UNSHELVE_BACKUP_EVERY_HOURS, keeps the newest
# UNSHELVE_BACKUP_KEEP_DAILY backups and the newest one of each of the last
# UNSHELVE_BACKUP_KEEP_WEEKLY calendar weeks (with 7 and 6, the oldest backup is 29 to 35 days
# old), and tries again UNSHELVE_BACKUP_RETRY_MINUTES after a failure. Write whole numbers
# without a leading zero; EVERY_HOURS and KEEP_DAILY must be 1 or more. The backups go to backups/ in this folder, or to UNSHELVE_BACKUP_DIR: use an absolute
# path outside the clone for a real instance, so that a new clone or `git clean` cannot delete it.
# (Compose reads a relative path from deploy/.) Make the folder yourself, with `mkdir -p`: the
# service then gives each new file to you, not to root.
# UNSHELVE_BACKUP_DIR=/Users/you/unshelve-backups
UNSHELVE_BACKUP_EVERY_HOURS=24
UNSHELVE_BACKUP_KEEP_DAILY=7
UNSHELVE_BACKUP_KEEP_WEEKLY=6
UNSHELVE_BACKUP_RETRY_MINUTES=60

# --- Production -------------------------------------------------------------
# On a server, docs/quickstart.md adds five values at the end of this file:
# COMPOSE_FILE=compose.prod.yaml, UNSHELVE_DOMAIN, a long random UNSHELVE_DB_PASSWORD,
# UNSHELVE_OWNER_TELEGRAM_ID and UNSHELVE_BACKUP_DIR.
# compose.prod.yaml puts Caddy in front of the web app, with HTTPS for UNSHELVE_DOMAIN, and it
# opens no other port. Compose stops when the domain or the password is missing.
