# Copy to .env and fill in. Never commit .env.
# Everything works without this file: the defaults use fake providers and fixture fetching.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
UNSHELVE_TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. The bot answers nobody else, and `unshelve auth link`
# makes a sign-in link for this user. For a local trial without Telegram, any number works.
UNSHELVE_OWNER_TELEGRAM_ID=
# Chats to capture from, as a JSON list. Channel ids start with -100. To find the id of your
# channel: make the bot an administrator, post one message, and read `docker compose logs bot`.
UNSHELVE_CAPTURE_CHAT_IDS=[]
# The weekly digest: the bot sends it on this day and hour, in this time zone (a name such
# as Europe/Helsinki). A digest that is late by more than 48 hours is skipped.
UNSHELVE_TIMEZONE=UTC
UNSHELVE_DIGEST_DAY=sunday
UNSHELVE_DIGEST_HOUR=9
# The reading time of a digest, in minutes (5 to 600): its items fit into it (note 34).
UNSHELVE_DIGEST_MINUTES=60

# --- Providers --------------------------------------------------------------
# fake: deterministic local stand-ins, no cost. live: Claude writes the cards (ADR 0011).
UNSHELVE_PROVIDERS=fake
# fixtures: no web; each saved link keeps its saved text. live: the worker reads the page
# of each saved link from the internet, through the guard (ADR 0010).
UNSHELVE_FETCHER=fixtures
# One fetch, with its redirects, may take this many seconds.
UNSHELVE_FETCH_TIMEOUT=30
# Seconds between two requests to the same host.
UNSHELVE_FETCH_HOST_INTERVAL=1
# UNSHELVE_FETCH_USER_AGENT=Mozilla/5.0 (compatible; Unshelve/0.1)
# claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5. Note 17 compares their prices.
UNSHELVE_LLM_MODEL=claude-opus-5-5
# How much the model thinks before it writes a card: low, medium, high, xhigh or max.
UNSHELVE_LLM_EFFORT=low
# No new call on a day when the calls have cost this many dollars. Stored answers are free,
# and so is a batch that you accepted by hand.
UNSHELVE_LLM_DAILY_BUDGET_USD=1.00
# live: each card is asked at once. batch: the cards wait, and `unshelve llm batch send` asks
# for all of them in one batch at half the price (note 29). For the import of a large export.
UNSHELVE_CARDS=live
# The prefilter of the scores against your goals (ADR 0014, note 32): an item whose card is
# less similar than this to each goal gets 0 without a question to the model. -1: no prefilter.
UNSHELVE_SCORE_PREFILTER=0.3
# Read by the Anthropic SDK when UNSHELVE_PROVIDERS=live.
ANTHROPIC_API_KEY=
# The vectors for search (ADR 0012). fake: local, no cost. voyage: Voyage AI makes them; the
# first 200 million tokens of an account are free. A new model gets its own embedding set:
# see `unshelve embeddings status`, `backfill` and `activate` (note 18).
UNSHELVE_EMBEDDER=fake
# voyage-4-large, voyage-4 or voyage-4-lite; vectors of 256, 512, 1024 or 2048 numbers.
UNSHELVE_EMBED_MODEL=voyage-4-large
UNSHELVE_EMBED_DIM=1024
# Read when UNSHELVE_EMBEDDER=voyage. A key of the Voyage platform (pa-...) or a model key of
# MongoDB Atlas (al-...); the address follows the key. Voyage can keep the texts that it gets
# and use them for training: opt out in its dashboard before you embed private texts.
VOYAGE_API_KEY=

# --- Public feed ------------------------------------------------------------
# The items that you make public, as one feed.json for your site (docs/adr/0004). "none"
# publishes nothing. "file" writes the feed to UNSHELVE_PUBLISH_FILE. In the stack, this path
# is inside the container of the worker: mount a folder there to see the file on this computer.
UNSHELVE_PUBLISH_TARGET=none
UNSHELVE_PUBLISH_FILE=var/public/feed.json

# --- Local stack ------------------------------------------------------------
UNSHELVE_WEB_BASE_URL=http://localhost:3000
UNSHELVE_DB_PASSWORD=unshelve
UNSHELVE_DB_PORT=54329
UNSHELVE_API_PORT=8000
UNSHELVE_WEB_PORT=3000
